{
  "name": "swarmspindle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run tooling/build.ts",
    "web": "bun run apps/web/main.ts",
    "worker": "bun run apps/worker/main.ts",
    "swarm": "bun run apps/cli/main.ts",
    "doctor": "bun run apps/cli/main.ts doctor"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.86.1",
    "typebox": "1.3.30",
    "zod": "4.6.4",
    "@simpleswarm/swarm": "workspace:*",
    "@simpleswarm/sandbox": "workspace:*",
    "@simpleswarm/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-client": "0.85.1",
    "@earendil-works/pi-protocol": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1"
  }
}
